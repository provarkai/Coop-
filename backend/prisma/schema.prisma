// Sprint 1: authentication, sessions, and role-based access control.
// Sprint 2: cooperatives, branches, committees, and per-cooperative membership.
// Sprint 3: member KYC, onboarding/approval, guarantors, beneficiaries, audit log.
// Regulatory compliance: a platform-wide REGULATOR role with cross-cooperative
// oversight, and a compliance-filing submit/review workflow.
// Sprint 4: savings products, member savings accounts, contributions/
// withdrawals, and simple-interest accrual.
// Sprint 5: loan products, applications, guarantor sign-off, approval,
// disbursement with a generated repayment schedule, repayments, and
// late-payment penalty assessment.
// Sprint 6: a simulated payment gateway for self-service savings
// contributions and loan repayments, plus reconciliation/transaction
// history reporting.
// Sprint 7: double-entry accounting — a per-cooperative chart of
// accounts, manual journal entries, automatic postings from savings/
// loan activity, trial balance/income statement/balance sheet
// reports, and simple per-account budgeting.
// Sprint 8: meeting scheduling with agendas, member RSVP and
// governance-recorded attendance, resolutions with member voting and
// governance tallying, and meeting minutes.
// Sprint 9: a per-cooperative document repository (arbitrary files stored
// as bytes, with metadata), and a simulated multi-channel notification
// log (email/SMS/WhatsApp/push) used for governance announcements and
// automatic meeting-invite notices. PDF generation (membership cards,
// meeting minutes) is computed on demand and not persisted.
// Sprint 10: reports & dashboards. KPI summary and month-over-month trend
// analytics computed on demand from existing data (no new tables). CSV
// exports of members/savings transactions/loans/journal entries. A
// scheduled (and manually triggerable) monthly digest that renders a PDF,
// stores it via the Document repository under a new REPORT category, and
// notifies members through the existing notification log.
// Sprint 12: AI features via OpenRouter. Self-scoped assistant Q&A and
// AI-authored monthly-report commentary (both computed on demand, not
// persisted). AI-generated meeting summaries, persisted on Meeting.
// aiSummary since regenerating them costs a real LLM call. Deterministic
// (non-LLM) loan risk scoring and fraud-signal detection, computed on
// demand from existing data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  REGULATOR
  COOPERATIVE_ADMIN
  CHAIRMAN
  SECRETARY
  TREASURER
  AUDITOR
  LOAN_OFFICER
  COMMITTEE_MEMBER
  MEMBER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  dateOfBirth DateTime?
  gender      String?
  phone       String?
  address     String?
  bvn         String?
  nin         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  cooperativeMemberships      CooperativeMembership[]
  committeeMemberships        CommitteeMember[]
  guarantorFor                Guarantor[]
  filingsSubmitted            ComplianceFiling[]      @relation("FilingSubmitter")
  filingsReviewed             ComplianceFiling[]      @relation("FilingReviewer")
  savingsTransactionsRecorded SavingsTransaction[]
  loanGuarantorFor            LoanGuarantor[]
  loanLedgerEntriesRecorded   LoanLedgerEntry[]
  journalEntriesPosted        JournalEntry[]
  meetingsCreated             Meeting[]               @relation("MeetingCreator")
  meetingMinutesRecorded      Meeting[]               @relation("MeetingMinutesRecorder")
  meetingAttendances          Attendance[]
  resolutionsProposed         Resolution[]            @relation("ResolutionProposer")
  documentsUploaded           Document[]              @relation("DocumentUploader")
  notificationsReceived       Notification[]          @relation("NotificationRecipient")
  notificationsSent           Notification[]          @relation("NotificationSender")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  EXITED
}

model Cooperative {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  registrationNumber      String?
  email                   String?
  phone                   String?
  address                 String?
  bylaws                  String?
  financialYearStartMonth Int      @default(1)
  financialYearStartDay   Int      @default(1)
  currency                String   @default("NGN")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  branches          Branch[]
  committees        Committee[]
  memberships       CooperativeMembership[]
  auditLogs         AuditLog[]
  complianceFilings ComplianceFiling[]
  savingsProducts   SavingsProduct[]
  savingsAccounts   SavingsAccount[]
  loanProducts      LoanProduct[]
  loans             Loan[]
  payments          Payment[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  budgets           Budget[]
  meetings          Meeting[]
  documents         Document[]
  notifications     Notification[]
}

model Branch {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  phone         String?
  email         String?
  isHeadOffice  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cooperativeId, name])
}

model Committee {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  members CommitteeMember[]

  @@unique([cooperativeId, name])
}

model CommitteeMember {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  joinedAt    DateTime  @default(now())

  @@unique([committeeId, userId])
}

model CooperativeMembership {
  id               String           @id @default(cuid())
  cooperativeId    String
  cooperative      Cooperative      @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role             @default(MEMBER)
  status           MembershipStatus @default(ACTIVE)
  membershipNumber String?
  category         String           @default("ORDINARY")
  joinedAt         DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  guarantors      Guarantor[]
  beneficiaries   Beneficiary[]
  savingsAccounts SavingsAccount[]
  loans           Loan[]
  payments        Payment[]
  votes           Vote[]

  @@unique([cooperativeId, userId])
  @@unique([cooperativeId, membershipNumber])
}

enum GuarantorStatus {
  PENDING
  APPROVED
  DECLINED
}

model Guarantor {
  id              String                @id @default(cuid())
  membershipId    String
  membership      CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  guarantorUserId String
  guarantorUser   User                  @relation(fields: [guarantorUserId], references: [id], onDelete: Cascade)
  status          GuarantorStatus       @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([membershipId, guarantorUserId])
}

model Beneficiary {
  id           String                @id @default(cuid())
  membershipId String
  membership   CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String
  phone        String?
  address      String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model AuditLog {
  id            String       @id @default(cuid())
  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  actorUserId   String?
  action        String
  targetType    String
  targetId      String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([cooperativeId])
}

enum ComplianceFilingType {
  ANNUAL_RETURN
  FINANCIAL_STATEMENT
  AGM_MINUTES
  OTHER
}

enum ComplianceFilingStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ComplianceFiling {
  id                String                 @id @default(cuid())
  cooperativeId     String
  cooperative       Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedBy       User                   @relation("FilingSubmitter", fields: [submittedByUserId], references: [id])
  type              ComplianceFilingType
  period            String
  title             String
  notes             String?
  documentUrl       String?
  status            ComplianceFilingStatus @default(SUBMITTED)
  reviewedByUserId  String?
  reviewedBy        User?                  @relation("FilingReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([cooperativeId])
  @@index([status])
}

enum SavingsAccountStatus {
  ACTIVE
  DORMANT
  CLOSED
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
}

model SavingsProduct {
  id                  String      @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name                String
  code                String
  interestRatePercent Decimal     @default(0) @db.Decimal(5, 2)
  minimumBalance      Decimal     @default(0) @db.Decimal(14, 2)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  accounts SavingsAccount[]

  @@unique([cooperativeId, code])
}

model SavingsAccount {
  id                    String                @id @default(cuid())
  cooperativeId         String
  cooperative           Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  membershipId          String
  membership            CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  productId             String
  product               SavingsProduct        @relation(fields: [productId], references: [id])
  accountNumber         String
  balance               Decimal               @default(0) @db.Decimal(14, 2)
  status                SavingsAccountStatus  @default(ACTIVE)
  lastInterestAccrualAt DateTime?
  openedAt              DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  transactions SavingsTransaction[]
  payments     Payment[]

  @@unique([cooperativeId, accountNumber])
  @@index([membershipId])
}

model SavingsTransaction {
  id               String                 @id @default(cuid())
  accountId        String
  account          SavingsAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             SavingsTransactionType
  amount           Decimal                @db.Decimal(14, 2)
  balanceAfter     Decimal                @db.Decimal(14, 2)
  narration        String?
  recordedByUserId String?
  recordedBy       User?                  @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime               @default(now())

  @@index([accountId])
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum RepaymentInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum LoanLedgerEntryType {
  DISBURSEMENT
  REPAYMENT
  PENALTY
}

model LoanProduct {
  id                  String      @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name                String
  code                String
  interestRatePercent Decimal     @default(0) @db.Decimal(5, 2)
  maxAmount           Decimal     @db.Decimal(14, 2)
  maxTermMonths       Int
  penaltyRatePercent  Decimal     @default(0) @db.Decimal(5, 2)
  requiredGuarantors  Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  loans Loan[]

  @@unique([cooperativeId, code])
}

model Loan {
  id                  String                @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  membershipId        String
  membership          CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  productId           String
  product             LoanProduct           @relation(fields: [productId], references: [id])
  principal           Decimal               @db.Decimal(14, 2)
  interestRatePercent Decimal               @db.Decimal(5, 2)
  termMonths          Int
  status              LoanStatus            @default(PENDING)
  outstandingBalance  Decimal               @default(0) @db.Decimal(14, 2)
  rejectionReason     String?
  approvedByUserId    String?
  approvedAt          DateTime?
  disbursedByUserId   String?
  disbursedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  guarantors LoanGuarantor[]
  schedule   RepaymentInstallment[]
  ledger     LoanLedgerEntry[]
  payments   Payment[]

  @@index([cooperativeId])
  @@index([membershipId])
}

model LoanGuarantor {
  id              String          @id @default(cuid())
  loanId          String
  loan            Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorUserId String
  guarantorUser   User            @relation(fields: [guarantorUserId], references: [id], onDelete: Cascade)
  status          GuarantorStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([loanId, guarantorUserId])
}

model RepaymentInstallment {
  id                String                     @id @default(cuid())
  loanId            String
  loan              Loan                       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  principalDue      Decimal                    @db.Decimal(14, 2)
  interestDue       Decimal                    @db.Decimal(14, 2)
  amountPaid        Decimal                    @default(0) @db.Decimal(14, 2)
  status            RepaymentInstallmentStatus @default(PENDING)
  paidAt            DateTime?

  @@unique([loanId, installmentNumber])
  @@index([loanId])
}

model LoanLedgerEntry {
  id               String              @id @default(cuid())
  loanId           String
  loan             Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type             LoanLedgerEntryType
  amount           Decimal             @db.Decimal(14, 2)
  balanceAfter     Decimal             @db.Decimal(14, 2)
  narration        String?
  recordedByUserId String?
  recordedBy       User?               @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime            @default(now())

  @@index([loanId])
}

enum PaymentPurpose {
  SAVINGS_DEPOSIT
  LOAN_REPAYMENT
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

model Payment {
  id               String                @id @default(cuid())
  cooperativeId    String
  cooperative      Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  membershipId     String
  membership       CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  purpose          PaymentPurpose
  savingsAccountId String?
  savingsAccount   SavingsAccount?       @relation(fields: [savingsAccountId], references: [id])
  loanId           String?
  loan             Loan?                 @relation(fields: [loanId], references: [id])
  amount           Decimal               @db.Decimal(14, 2)
  gatewayReference String                @unique
  status           PaymentStatus         @default(INITIATED)
  narration        String?
  completedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([cooperativeId])
  @@index([membershipId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalEntrySource {
  MANUAL
  SAVINGS
  LOAN
}

model Account {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          AccountType
  isSystem      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  journalLines JournalLine[]
  budgets      Budget[]

  @@unique([cooperativeId, code])
}

model JournalEntry {
  id             String             @id @default(cuid())
  cooperativeId  String
  cooperative    Cooperative        @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  date           DateTime           @default(now())
  memo           String?
  source         JournalEntrySource @default(MANUAL)
  sourceId       String?            @unique
  postedByUserId String?
  postedBy       User?              @relation(fields: [postedByUserId], references: [id])
  createdAt      DateTime           @default(now())

  lines JournalLine[]

  @@index([cooperativeId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)

  @@index([journalEntryId])
  @@index([accountId])
}

model Budget {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  period        String
  plannedAmount Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accountId, period])
}

enum MeetingType {
  AGM
  BOARD
  COMMITTEE
  SPECIAL
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  ABSENT
  EXCUSED
}

enum ResolutionStatus {
  PROPOSED
  PASSED
  REJECTED
  WITHDRAWN
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

model Meeting {
  id                      String        @id @default(cuid())
  cooperativeId           String
  cooperative             Cooperative   @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  title                   String
  type                    MeetingType   @default(SPECIAL)
  scheduledAt             DateTime
  location                String?
  status                  MeetingStatus @default(SCHEDULED)
  minutes                 String?
  aiSummary               String?
  minutesRecordedByUserId String?
  minutesRecordedBy       User?         @relation("MeetingMinutesRecorder", fields: [minutesRecordedByUserId], references: [id])
  createdByUserId         String
  createdBy               User          @relation("MeetingCreator", fields: [createdByUserId], references: [id])
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  agendaItems AgendaItem[]
  attendances Attendance[]
  resolutions Resolution[]

  @@index([cooperativeId])
}

model AgendaItem {
  id          String  @id @default(cuid())
  meetingId   String
  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?

  resolutions Resolution[]

  @@index([meetingId])
}

model Attendance {
  id          String           @id @default(cuid())
  meetingId   String
  meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttendanceStatus @default(INVITED)
  respondedAt DateTime?
  recordedAt  DateTime?

  @@unique([meetingId, userId])
}

model Resolution {
  id               String           @id @default(cuid())
  meetingId        String
  meeting          Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItemId     String?
  agendaItem       AgendaItem?      @relation(fields: [agendaItemId], references: [id])
  title            String
  description      String?
  status           ResolutionStatus @default(PROPOSED)
  proposedByUserId String
  proposedBy       User             @relation("ResolutionProposer", fields: [proposedByUserId], references: [id])
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  votes Vote[]

  @@index([meetingId])
}

model Vote {
  id           String                @id @default(cuid())
  resolutionId String
  resolution   Resolution            @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  membershipId String
  membership   CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  choice       VoteChoice
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([resolutionId, membershipId])
}

enum DocumentCategory {
  BYLAWS
  POLICY
  FINANCIAL_STATEMENT
  MEETING_MINUTES
  FORM
  REPORT
  OTHER
}

model Document {
  id               String           @id @default(cuid())
  cooperativeId    String
  cooperative      Cooperative      @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User             @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  title            String
  category         DocumentCategory @default(OTHER)
  fileName         String
  mimeType         String
  sizeBytes        Int
  content          Bytes
  createdAt        DateTime         @default(now())

  @@index([cooperativeId])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
}

model Notification {
  id              String              @id @default(cuid())
  cooperativeId   String?
  cooperative     Cooperative?        @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User                @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  subject         String?
  body            String
  status          NotificationStatus  @default(SENT)
  sentByUserId    String?
  sentBy          User?               @relation("NotificationSender", fields: [sentByUserId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([cooperativeId])
  @@index([recipientUserId])
}
