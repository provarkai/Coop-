// Sprint 1: authentication, sessions, and role-based access control.
// Sprint 2: cooperatives, branches, committees, and per-cooperative membership.
// Sprint 3: member KYC, onboarding/approval, guarantors, beneficiaries, audit log.
// Regulatory compliance: a platform-wide REGULATOR role with cross-cooperative
// oversight, and a compliance-filing submit/review workflow.
// Sprint 4: savings products, member savings accounts, contributions/
// withdrawals, and simple-interest accrual.
// Sprint 5: loan products, applications, guarantor sign-off, approval,
// disbursement with a generated repayment schedule, repayments, and
// late-payment penalty assessment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  REGULATOR
  COOPERATIVE_ADMIN
  CHAIRMAN
  SECRETARY
  TREASURER
  AUDITOR
  LOAN_OFFICER
  COMMITTEE_MEMBER
  MEMBER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  dateOfBirth DateTime?
  gender      String?
  phone       String?
  address     String?
  bvn         String?
  nin         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens               RefreshToken[]
  passwordResetTokens         PasswordResetToken[]
  cooperativeMemberships      CooperativeMembership[]
  committeeMemberships        CommitteeMember[]
  guarantorFor                Guarantor[]
  filingsSubmitted            ComplianceFiling[]      @relation("FilingSubmitter")
  filingsReviewed             ComplianceFiling[]      @relation("FilingReviewer")
  savingsTransactionsRecorded SavingsTransaction[]
  loanGuarantorFor            LoanGuarantor[]
  loanLedgerEntriesRecorded   LoanLedgerEntry[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  EXITED
}

model Cooperative {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  registrationNumber      String?
  email                   String?
  phone                   String?
  address                 String?
  bylaws                  String?
  financialYearStartMonth Int      @default(1)
  financialYearStartDay   Int      @default(1)
  currency                String   @default("NGN")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  branches          Branch[]
  committees        Committee[]
  memberships       CooperativeMembership[]
  auditLogs         AuditLog[]
  complianceFilings ComplianceFiling[]
  savingsProducts   SavingsProduct[]
  savingsAccounts   SavingsAccount[]
  loanProducts      LoanProduct[]
  loans             Loan[]
}

model Branch {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  phone         String?
  email         String?
  isHeadOffice  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cooperativeId, name])
}

model Committee {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  members CommitteeMember[]

  @@unique([cooperativeId, name])
}

model CommitteeMember {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  joinedAt    DateTime  @default(now())

  @@unique([committeeId, userId])
}

model CooperativeMembership {
  id               String           @id @default(cuid())
  cooperativeId    String
  cooperative      Cooperative      @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role             @default(MEMBER)
  status           MembershipStatus @default(ACTIVE)
  membershipNumber String?
  category         String           @default("ORDINARY")
  joinedAt         DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  guarantors      Guarantor[]
  beneficiaries   Beneficiary[]
  savingsAccounts SavingsAccount[]
  loans           Loan[]

  @@unique([cooperativeId, userId])
  @@unique([cooperativeId, membershipNumber])
}

enum GuarantorStatus {
  PENDING
  APPROVED
  DECLINED
}

model Guarantor {
  id              String                @id @default(cuid())
  membershipId    String
  membership      CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  guarantorUserId String
  guarantorUser   User                  @relation(fields: [guarantorUserId], references: [id], onDelete: Cascade)
  status          GuarantorStatus       @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([membershipId, guarantorUserId])
}

model Beneficiary {
  id           String                @id @default(cuid())
  membershipId String
  membership   CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String
  phone        String?
  address      String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model AuditLog {
  id            String       @id @default(cuid())
  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  actorUserId   String?
  action        String
  targetType    String
  targetId      String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([cooperativeId])
}

enum ComplianceFilingType {
  ANNUAL_RETURN
  FINANCIAL_STATEMENT
  AGM_MINUTES
  OTHER
}

enum ComplianceFilingStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ComplianceFiling {
  id                String                 @id @default(cuid())
  cooperativeId     String
  cooperative       Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedBy       User                   @relation("FilingSubmitter", fields: [submittedByUserId], references: [id])
  type              ComplianceFilingType
  period            String
  title             String
  notes             String?
  documentUrl       String?
  status            ComplianceFilingStatus @default(SUBMITTED)
  reviewedByUserId  String?
  reviewedBy        User?                  @relation("FilingReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([cooperativeId])
  @@index([status])
}

enum SavingsAccountStatus {
  ACTIVE
  DORMANT
  CLOSED
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
}

model SavingsProduct {
  id                  String      @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name                String
  code                String
  interestRatePercent Decimal     @default(0) @db.Decimal(5, 2)
  minimumBalance      Decimal     @default(0) @db.Decimal(14, 2)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  accounts SavingsAccount[]

  @@unique([cooperativeId, code])
}

model SavingsAccount {
  id                    String                @id @default(cuid())
  cooperativeId         String
  cooperative           Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  membershipId          String
  membership            CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  productId             String
  product               SavingsProduct        @relation(fields: [productId], references: [id])
  accountNumber         String
  balance               Decimal               @default(0) @db.Decimal(14, 2)
  status                SavingsAccountStatus  @default(ACTIVE)
  lastInterestAccrualAt DateTime?
  openedAt              DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  transactions SavingsTransaction[]

  @@unique([cooperativeId, accountNumber])
  @@index([membershipId])
}

model SavingsTransaction {
  id               String                 @id @default(cuid())
  accountId        String
  account          SavingsAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             SavingsTransactionType
  amount           Decimal                @db.Decimal(14, 2)
  balanceAfter     Decimal                @db.Decimal(14, 2)
  narration        String?
  recordedByUserId String?
  recordedBy       User?                  @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime               @default(now())

  @@index([accountId])
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum RepaymentInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum LoanLedgerEntryType {
  DISBURSEMENT
  REPAYMENT
  PENALTY
}

model LoanProduct {
  id                  String      @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name                String
  code                String
  interestRatePercent Decimal     @default(0) @db.Decimal(5, 2)
  maxAmount           Decimal     @db.Decimal(14, 2)
  maxTermMonths       Int
  penaltyRatePercent  Decimal     @default(0) @db.Decimal(5, 2)
  requiredGuarantors  Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  loans Loan[]

  @@unique([cooperativeId, code])
}

model Loan {
  id                  String                @id @default(cuid())
  cooperativeId       String
  cooperative         Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  membershipId        String
  membership          CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  productId           String
  product             LoanProduct           @relation(fields: [productId], references: [id])
  principal           Decimal               @db.Decimal(14, 2)
  interestRatePercent Decimal               @db.Decimal(5, 2)
  termMonths          Int
  status              LoanStatus            @default(PENDING)
  outstandingBalance  Decimal               @default(0) @db.Decimal(14, 2)
  rejectionReason     String?
  approvedByUserId    String?
  approvedAt          DateTime?
  disbursedByUserId   String?
  disbursedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  guarantors LoanGuarantor[]
  schedule   RepaymentInstallment[]
  ledger     LoanLedgerEntry[]

  @@index([cooperativeId])
  @@index([membershipId])
}

model LoanGuarantor {
  id              String          @id @default(cuid())
  loanId          String
  loan            Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  guarantorUserId String
  guarantorUser   User            @relation(fields: [guarantorUserId], references: [id], onDelete: Cascade)
  status          GuarantorStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([loanId, guarantorUserId])
}

model RepaymentInstallment {
  id                String                     @id @default(cuid())
  loanId            String
  loan              Loan                       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  principalDue      Decimal                    @db.Decimal(14, 2)
  interestDue       Decimal                    @db.Decimal(14, 2)
  amountPaid        Decimal                    @default(0) @db.Decimal(14, 2)
  status            RepaymentInstallmentStatus @default(PENDING)
  paidAt            DateTime?

  @@unique([loanId, installmentNumber])
  @@index([loanId])
}

model LoanLedgerEntry {
  id               String              @id @default(cuid())
  loanId           String
  loan             Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type             LoanLedgerEntryType
  amount           Decimal             @db.Decimal(14, 2)
  balanceAfter     Decimal             @db.Decimal(14, 2)
  narration        String?
  recordedByUserId String?
  recordedBy       User?               @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime            @default(now())

  @@index([loanId])
}
