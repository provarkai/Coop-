// Sprint 1: authentication, sessions, and role-based access control.
// Sprint 2: cooperatives, branches, committees, and per-cooperative membership.
// Sprint 3: member KYC, onboarding/approval, guarantors, beneficiaries, audit log.
// Regulatory compliance: a platform-wide REGULATOR role with cross-cooperative
// oversight, and a compliance-filing submit/review workflow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  REGULATOR
  COOPERATIVE_ADMIN
  CHAIRMAN
  SECRETARY
  TREASURER
  AUDITOR
  LOAN_OFFICER
  COMMITTEE_MEMBER
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)

  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?

  dateOfBirth  DateTime?
  gender       String?
  phone        String?
  address      String?
  bvn          String?
  nin          String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  cooperativeMemberships CooperativeMembership[]
  committeeMemberships   CommitteeMember[]
  guarantorFor           Guarantor[]
  filingsSubmitted       ComplianceFiling[] @relation("FilingSubmitter")
  filingsReviewed        ComplianceFiling[] @relation("FilingReviewer")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  EXITED
}

model Cooperative {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  registrationNumber      String?
  email                   String?
  phone                   String?
  address                 String?
  bylaws                  String?
  financialYearStartMonth Int      @default(1)
  financialYearStartDay   Int      @default(1)
  currency                String   @default("NGN")
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  branches          Branch[]
  committees        Committee[]
  memberships       CooperativeMembership[]
  auditLogs         AuditLog[]
  complianceFilings ComplianceFiling[]
}

model Branch {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  phone         String?
  email         String?
  isHeadOffice  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([cooperativeId, name])
}

model Committee {
  id            String      @id @default(cuid())
  cooperativeId String
  cooperative   Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  members CommitteeMember[]

  @@unique([cooperativeId, name])
}

model CommitteeMember {
  id          String    @id @default(cuid())
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  joinedAt    DateTime  @default(now())

  @@unique([committeeId, userId])
}

model CooperativeMembership {
  id               String           @id @default(cuid())
  cooperativeId    String
  cooperative      Cooperative      @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role             @default(MEMBER)
  status           MembershipStatus @default(ACTIVE)
  membershipNumber String?
  category         String           @default("ORDINARY")
  joinedAt         DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  guarantors    Guarantor[]
  beneficiaries Beneficiary[]

  @@unique([cooperativeId, userId])
  @@unique([cooperativeId, membershipNumber])
}

enum GuarantorStatus {
  PENDING
  APPROVED
  DECLINED
}

model Guarantor {
  id              String                @id @default(cuid())
  membershipId    String
  membership      CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  guarantorUserId String
  guarantorUser   User                  @relation(fields: [guarantorUserId], references: [id], onDelete: Cascade)
  status          GuarantorStatus       @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([membershipId, guarantorUserId])
}

model Beneficiary {
  id           String                @id @default(cuid())
  membershipId String
  membership   CooperativeMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String
  phone        String?
  address      String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model AuditLog {
  id            String       @id @default(cuid())
  cooperativeId String?
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  actorUserId   String?
  action        String
  targetType    String
  targetId      String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([cooperativeId])
}

enum ComplianceFilingType {
  ANNUAL_RETURN
  FINANCIAL_STATEMENT
  AGM_MINUTES
  OTHER
}

enum ComplianceFilingStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model ComplianceFiling {
  id                String                 @id @default(cuid())
  cooperativeId     String
  cooperative       Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedBy       User                   @relation("FilingSubmitter", fields: [submittedByUserId], references: [id])
  type              ComplianceFilingType
  period            String
  title             String
  notes             String?
  documentUrl       String?
  status            ComplianceFilingStatus @default(SUBMITTED)
  reviewedByUserId  String?
  reviewedBy        User?                  @relation("FilingReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([cooperativeId])
  @@index([status])
}
