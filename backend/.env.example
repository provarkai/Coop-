DATABASE_URL="postgresql://ncms:ncms@localhost:5432/ncms?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001

FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI features (Sprint 12) are routed through OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY="change-me-to-an-openrouter-api-key"
OPENROUTER_MODEL="anthropic/claude-haiku-4.5"

# Real payments (Paystack) — https://dashboard.paystack.com/#/settings/developer
# Use a sk_test_... key while cooperatives are still connecting test-mode bank
# accounts; switch to a sk_live_... key only once ready to move real money.
# The same secret key is used to verify inbound webhook signatures (no
# separate webhook secret — Paystack signs with your secret key).
PAYSTACK_SECRET_KEY="change-me-to-a-paystack-secret-key"
